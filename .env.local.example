NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:contacto@japapp.app
# Supabase → Project Settings → API → service_role key. Solo la usa
# el cron de recordatorio de saldo (src/app/api/cron/balance-reminders);
# nunca debe llegar a código cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Cualquier string random largo — protege el endpoint del cron para
# que solo Vercel (o quien conozca el secreto) pueda dispararlo.
CRON_SECRET=your-cron-secret
# Google Cloud Console → proyecto con "Google Photos Library API"
# habilitada → credenciales OAuth. Ver specs/019-fotos-y-google-photos.md
# para el checklist completo (crear proyecto, publicar "En producción",
# generar estas credenciales).
GOOGLE_PHOTOS_CLIENT_ID=your-google-photos-client-id
GOOGLE_PHOTOS_CLIENT_SECRET=your-google-photos-client-secret
# Se obtiene UNA sola vez con el OAuth Playground
# (developers.google.com/oauthplayground), autorizando los scopes
# photoslibrary.appendonly y photoslibrary.readonly.appcreateddata. No
# expira mientras el proyecto de Google Cloud esté "En producción".
GOOGLE_PHOTOS_REFRESH_TOKEN=your-google-photos-refresh-token
# Opcional: id del álbum "JAPApp" (creado una vez vía la API) para que
# las fotos no queden sueltas en la biblioteca. Sin esto, sube igual.
GOOGLE_PHOTOS_ALBUM_ID=your-google-photos-album-id
